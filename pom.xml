    <name>${project.groupId}:${project.artifactId}</name>
    <description> Emc4j stands for Extensible Modular Context for Java. Emc4j allows to define modular applications
        using a declarative xml approach defining an extension tree. When launching the application, emc4j will load the
        modules and their dependencies from defined repositories and load each extensions into a dedicated module layer
        and Spring context. </description>
    <inceptionYear>2021</inceptionYear>
    <url>https://github.com/treilhes/emc4j</url>

    <organization>
        <name>Treilhes</name>
        <url>https://www.treilhes.com</url>
